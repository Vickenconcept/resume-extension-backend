// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  name           String
  email          String   @unique
  password       String
  role           String   @default("user") // user, admin
  defaultTemplate String? @default("classic") @map("default_template") // classic, modern, compact
  credits        Int      @default(0) // Available credits for generation
  freeTrialUsed  Int      @default(0) @map("free_trial_used") // Number of free generations used
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  resumes Resume[]
  tokens  Token[]
  payments Payment[]
  usageLogs UsageLog[]
  feedback Feedback[]
  subscriptions Subscription[]

  @@index([role])
  @@map("users")
}

model Resume {
  id                    Int       @id @default(autoincrement())
  userId                Int       @map("user_id")
  resumeId              String    @unique @map("resume_id")
  filename              String
  displayName           String?   @map("display_name") // User-friendly name
  cloudinaryUrl         String    @map("cloudinary_url")
  cloudinaryPublicId    String    @map("cloudinary_public_id")
  parsedContent         Json?     @map("parsed_content")
  tailoredDocxUrl       String?   @map("tailored_docx_url")
  tailoredPdfUrl        String?   @map("tailored_pdf_url")
  tailoredResumeText    String?   @map("tailored_resume_text") @db.Text
  coverLetter           String?   @map("cover_letter") @db.Text
  downloadUrls          Json?     @map("download_urls")
  qualityScore          Json?     @map("quality_score") // Quality validation scores
  similarityMetrics     Json?     @map("similarity_metrics") // Similarity scores and keywords
  isDefault             Boolean   @default(false) @map("is_default") // Default resume for AI
  folder                String?   // Folder/group name (optional)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions ResumeVersion[] // Resume versions/edits

  @@index([userId])
  @@index([resumeId])
  @@index([userId, isDefault])
  @@map("resumes")
}

model ResumeVersion {
  id                    Int       @id @default(autoincrement())
  resumeId              Int       @map("resume_id")
  versionName           String?   @map("version_name") // Optional version name
  tailoredResumeText    String    @map("tailored_resume_text") @db.Text
  coverLetter           String?   @map("cover_letter") @db.Text
  tailoredDocxUrl       String?   @map("tailored_docx_url")
  tailoredPdfUrl        String?   @map("tailored_pdf_url")
  downloadUrls          Json?     @map("download_urls")
  isCurrent             Boolean   @default(false) @map("is_current") // Current version being edited
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@index([resumeId, isCurrent])
  @@map("resume_versions")
}

model Token {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @db.VarChar(768) // JWT length; 768 = max for MySQL unique index (utf8mb4)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("tokens")
}

model Payment {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  paystackRef     String   @unique @map("paystack_ref") // Paystack reference
  amount          Decimal  @db.Decimal(10, 2) // Amount in USD
  credits         Int      // Credits purchased
  status          String   @default("pending") // pending, completed, failed
  paystackResponse Json?   @map("paystack_response") // Full Paystack response
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paystackRef])
  @@index([status])
  @@map("payments")
}

model UsageLog {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  action          String   // 'generate' or 'regenerate'
  creditsUsed     Int      @default(1) @map("credits_used")
  usedFreeTrial   Boolean  @default(false) @map("used_free_trial")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("usage_logs")
}

model PaymentPlan {
  id          Int      @id @default(autoincrement())
  amount      Float    // Amount in USD
  credits     Int      // Number of credits
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("payment_plans")
}

model Subscription {
  id                        Int      @id @default(autoincrement())
  userId                    Int      @map("user_id")
  status                    String   @default("active") // active, past_due, canceled
  amount                    Decimal  @db.Decimal(10, 2) // Amount in USD per month
  credits                   Int      // Credits per month
  paystackAuthorizationCode String?  @map("paystack_authorization_code")
  paystackCustomerCode      String?  @map("paystack_customer_code")
  lastChargedAt             DateTime? @map("last_charged_at")
  nextChargeAt              DateTime? @map("next_charge_at")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([nextChargeAt])
  @@map("subscriptions")
}

model Feedback {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  type        String   // 'resume' or 'cover_letter'
  rating      String   // 'positive' or 'negative'
  message     String?  @db.Text // Feedback message (required for negative feedback)
  resumeId    String?  @map("resume_id") // Resume ID if applicable
  versionId   Int?     @map("version_id") // Resume version ID if applicable
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([rating])
  @@index([createdAt])
  @@map("feedback")
}
